SEC_USER_AGENT="Your Name your@email.com"
# The model secbench.extract runs. These MODEL_* settings can instead live in a file per
# setup (.env.openai, .env.vllm; git ignores every .env.* but this one), used with
# --env-file .env.vllm: the MODEL_* settings then come only from that file, while
# SEC_USER_AGENT stays here.
# MODEL_PROVIDER: openai (the default), any OpenAI-compatible chat completions API at
# MODEL_BASE_URL; or anthropic, Anthropic's Messages API through the anthropic SDK
# (MODEL_NAME such as claude-opus-5-5; MODEL_BASE_URL and MODEL_TEMPERATURE are not
# used, and MODEL_API_KEY is required)
MODEL_PROVIDER=""
# openai: such as https://api.openai.com/v1 or a local server at http://localhost:8000/v1
MODEL_BASE_URL=""
MODEL_NAME=""
# openai: optional; a local server may need none
MODEL_API_KEY=""
# openai: optional; blank sends no temperature, so the server's default applies (some
# reasoning models accept only their default)
MODEL_TEMPERATURE="0"
# openai: optional JSON object merged into every request body (it can't set model,
# messages, stream or temperature); blank sends nothing more. Single-quote it, such as
# '{"reasoning_effort": "medium"}' (OpenAI) or
# '{"chat_template_kwargs": {"enable_thinking": false}}' (vLLM)
MODEL_EXTRA_BODY=""
# anthropic: optional; low, medium, high, xhigh or max (sent as output_config.effort);
# blank sends none, so the model's default applies (medium on claude-opus-5-5)
MODEL_EFFORT=""
# Optional; how many calls run at once (default 4). A vLLM server batches concurrent
# requests, so more raises throughput; a hosted API may answer 429 (retried with backoff)
MODEL_CONCURRENCY=""
# Optional, dollars per million tokens, for the run's cost estimate
MODEL_PRICE_INPUT=""
MODEL_PRICE_OUTPUT=""
