# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# Tool caches
.pytest_cache/
.ruff_cache/

# Secrets: .env and per-setup settings files (.env.openai, .env.vllm)
.env
.env.*
!.env.example

# Downloaded SEC data and evaluation runs; the stage 2 company list and split are
# tracked, so the split is fixed before downloading (PLAN.md Decisions 2026-10-27)
data/*
!data/companies.csv
!data/companies.json
# The frozen test releases (secbench.splits): a test split can't change once frozen
!data/frozen_test_releases.csv
runs/
# Stage 2 training runs: adapters, optimizer states, logs (secbench.train)
training/
# Tars for and from a GPU instance (secbench.bundle, scripts/vast_setup.sh)
gpu-bundle-*.tar
gpu-bundle-*.tar.part
results-*.tar

# macOS
.DS_Store
